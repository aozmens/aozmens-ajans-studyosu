{
  "name": "ajans-studyosu",
  "version": "3.0.0",
  "private": true,
  "description": "Yapay zeka ajanlarından oluşan dijital ajans (web sürümü)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web install --no-audit --no-fund && npm --prefix web run build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.mjs",
    "build:windows": "node scripts/build-windows.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@resvg/resvg-js": "^2.6.2",
    "express": "^4.22.3",
    "fflate": "^0.8.3",
    "jsonrepair": "^3.15.0",
    "opentype.js": "^2.0.0",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5"
  }
}
